# huntkit ist eine private App: Jede Antwort – Seite, Bild, Wortliste, API –
# trägt die Bitte, nicht indexiert zu werden. Das meta-Tag in index.html
# erreicht nur HTML; der Header gilt auch für alles andere.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Referrer-Policy "same-origin"
</IfModule>
